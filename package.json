{
  "name": "networkmind",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --import tsx scripts/test-pipeline.ts",
    "test:e2e": "playwright test",
    "check:models": "node --import tsx scripts/check-openrouter.ts",
    "db:wait": "node --import tsx scripts/wait-for-db.ts",
    "db:reset": "docker compose down -v && docker compose up -d postgres && npm run db:wait && npm run db:migrate && npm run db:seed",
    "dev:db": "docker compose up -d postgres && npm run db:wait && npm run dev",
    "dev:full": "docker compose up -d postgres && npm run db:wait && npm run db:migrate && npm run db:seed && npm run dev",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "postinstall": "node scripts/generate-prisma.mjs",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "jsdom": "^27.1.0",
    "postcss": "8.5.23",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "8.5.23",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.4",
    "js-yaml": "4.3.0",
    "hono": "4.12.32",
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "sharp": "0.35.3"
  }
}
